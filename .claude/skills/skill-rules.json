{
    "version": "1.0",
    "description": "Skill activation triggers for Football-501. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "react-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Next.js 16 / React 19 / Tailwind 4 frontend patterns for Football-501 PWA",
            "promptTriggers": {
                "keywords": [
                    "react",
                    "next.js",
                    "nextjs",
                    "component",
                    "frontend",
                    "UI",
                    "page",
                    "context",
                    "hook",
                    "tailwind",
                    "routing",
                    "app router",
                    "pwa",
                    "jsx",
                    "tsx"
                ],
                "intentPatterns": [
                    "(create|add|make|build|update|modify).*?(component|page|hook|UI|route|context)",
                    "(how to|best practice).*?(react|next\\.?js|tailwind|component|hook)",
                    "(style|design|layout).*?(component|UI)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "frontend-react/src/**/*.tsx",
                    "frontend-react/src/**/*.ts",
                    "frontend-react/src/app/**/*.tsx",
                    "frontend-react/src/components/**/*.tsx",
                    "frontend-react/src/hooks/**/*.ts"
                ],
                "pathExclusions": [
                    "**/*.test.ts",
                    "**/*.test.tsx",
                    "**/*.spec.ts",
                    "**/*.spec.tsx"
                ]
            }
        },
        "spring-boot-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Spring Boot 3.x / Java 17 backend patterns for Football-501",
            "promptTriggers": {
                "keywords": [
                    "spring boot",
                    "controller",
                    "service",
                    "repository",
                    "endpoint",
                    "rest api",
                    "java",
                    "jpa",
                    "hibernate",
                    "spring security",
                    "websocket",
                    "stomp",
                    "bean validation",
                    "game engine",
                    "testcontainers",
                    "scheduler"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(endpoint|controller|service|repository|API)",
                    "(fix|handle|debug).*?(error|exception|backend)",
                    "(implement|add).*?(validation|security|websocket|game.*?logic)",
                    "(organize|structure|refactor).*?(backend|service|API)",
                    "(how to|best practice).*?(spring|java|jpa|controller)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "backend/src/**/*.java",
                    "backend/src/main/**/*.java",
                    "backend/src/test/**/*.java"
                ],
                "pathExclusions": [
                    "**/*Test.java",
                    "**/test/**/*.java"
                ],
                "contentPatterns": [
                    "@RestController",
                    "@Service",
                    "@Repository",
                    "@SpringBootApplication",
                    "@MessageMapping"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        }
    }
}
